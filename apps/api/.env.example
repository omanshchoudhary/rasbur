# Server
PORT=3001
NODE_ENV=development

# Origin of the web app. Used for the CORS allowlist and for OAuth redirects back to the client.
FRONTEND_URL=http://localhost:5173

# MongoDB connection string (Atlas or a local instance).
MONGODB_URI=

# Upstash Redis REST credentials. Used for rate limit counters, daily usage counters,
# and the refresh-token session store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RS256 keypair for signing and verifying JWTs, as PEM contents rather than file paths.
# Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Keep the private key out of version control.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Google OAuth. Create credentials at https://console.cloud.google.com/apis/credentials
# and register the callback URL below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# GitHub OAuth. Create an app at https://github.com/settings/developers and set the
# callback URL below as the authorization callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback
