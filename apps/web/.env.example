# Keep empty in dev to use the Vite dev proxy (/api, /auth/*, /socket.io -> VITE_API_PROXY_TARGET).
# In production (Vercel) this MUST be set to the deployed API origin (e.g. https://rasbur-api.onrender.com)
# so the Socket.IO client can reach the backend. Without it, useWebSocket() falls back to
# window.location.origin and the connection will fail with "Connection error" on the Decode page.
VITE_API_BASE_URL=

# Backend target used by Vite dev server proxy.
VITE_API_PROXY_TARGET=http://localhost:3001
